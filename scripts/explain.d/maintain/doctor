#!/usr/bin/env zsh
# Description: Check explainers.ts, registry.ts and collections.ts for drift
set -euo pipefail

source "${EXPLAIN_D}/_lib.sh"

exit_code=0
output=$(run_data doctor) || exit_code=$?

# Plain prefix matching rather than grep -P: BSD grep (macOS default) has
# no -P, and -E's \t handling is unreliable across grep implementations.
problems=$(awk -F'\t' '$1 == "problem"' <<<"$output" || true)

if [[ -n "$problems" ]]; then
	gum style --foreground "${EXPLAIN_DANGER:-9}" --bold "explain doctor: drift found"
	echo "$problems" | cut -f2- | while IFS= read -r line; do
		echo "  ✗ $line"
	done
else
	gum style --foreground "${EXPLAIN_OK:-10}" --bold "explain doctor: clean"
fi

exit "${exit_code:-0}"
