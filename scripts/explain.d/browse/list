#!/usr/bin/env zsh
# Description: List explainers, tags or collections
set -euo pipefail

source "${EXPLAIN_D}/_lib.sh"

usage() {
	echo "Usage: explain list [explainers|tags|collections]" >&2
	echo "Default target is explainers." >&2
}

target="${1:-explainers}"

case "$target" in
	explainers)
		run_data explainers | print_table "id,title,tags"
		;;
	tags)
		run_data tags | print_table "tag,explainers"
		;;
	collections)
		run_data collections | print_table "id,title,members"
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		echo "explain list: unknown target \"$target\"" >&2
		usage
		exit 1
		;;
esac
